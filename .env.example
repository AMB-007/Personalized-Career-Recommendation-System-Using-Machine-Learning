# Flask Environment
FLASK_APP=backend.app:create_app
FLASK_ENV=development
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# MySQL Database Configuration
# Preferred: mysqlconnector (mysql-connector-python)
# Alternative: pymysql (PyMySQL)
DATABASE_URL=mysql+mysqlconnector://root:YOUR_PASSWORD@localhost:3306/career_recommendation_db

# Individual MySQL connection parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_recommendation_db
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD
DB_DRIVER=mysqlconnector

# Production ML Model Configuration
MODEL_DIR=backend/ml/models
CAREER_DATA_PATH=backend/ml/data/career_knowledge_requirements.csv

# Application Server
PORT=5000
DEBUG=True
